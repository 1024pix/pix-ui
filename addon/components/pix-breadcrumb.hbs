<nav class="pix-breadcrumb" ...attributes>
  <ol>
    {{#each this.links as |link|}}
      {{#if link.route}}
        <li>
          <LinkTo @route={{link.route}} @models={{if @model (array @model) this.defaultModel}}>
            {{link.label}}
          </LinkTo>
          <PixIcon @name="chevronRight" @ariaHidden={{true}} />
        </li>
      {{else}}
        <li aria-current="page">
          <p>{{link.label}}</p>
        </li>
      {{/if}}
    {{/each}}
  </ol>
</nav>