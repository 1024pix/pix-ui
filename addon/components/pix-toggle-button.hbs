<div class={{this.className}} role="group" aria-labelledby="{{this.id}}">
  <PixLabel
    @for={{this.id}}
    @screenReaderOnly={{@screenReaderOnly}}
    @subLabel={{@subLabel}}
    @size={{@size}}
    @inlineLabel={{@inlineLabel}}
  >{{yield to="label"}}</PixLabel>
  <div class="radio">
    <input
      onchange={{this.onChange}}
      id="viewA"
      type="radio"
      name="toggle"
      value="viewA"
      checked={{not this.toggled}}
    />
    <label for="viewA">{{yield to="viewA"}}</label>
    <input
      onchange={{this.onChange}}
      id="viewB"
      type="radio"
      name="toggle"
      value="viewB"
      checked={{this.toggled}}
    />
    <label for="viewB">{{yield to="viewB"}}</label>
  </div>
</div>