<div class="table">
  <table class="pix-table" ...attributes>
    <caption class="screen-reader-only">{{@caption}}</caption>
    <thead>
      <tr>
        {{#each @headers as |header|}}
          <th scope="col">{{header.name}}</th>
        {{/each}}
      </tr>
    </thead>
    <tbody>
      {{#each this.computedData as |row|}}
        <tr>
          {{#each row as |value|}}
            <td>{{value}}</td>
          {{/each}}
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>