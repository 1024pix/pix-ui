<div class="pix-table">
  <table>
    <caption class="screen-reader-only">{{@caption}}</caption>
    <thead class={{this.headerClass}}>
      <tr>
        {{yield this.headerContext to="columns"}}
      </tr>
    </thead>
    <tbody>
      {{#each @data as |row|}}
        <tr>
          {{yield (this.getRowContext row) to="columns"}}
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>