<div class="pix-table" ...attributes>
  <table class={{this.tableClass}}>
    <caption class="screen-reader-only">{{this.caption}}</caption>
    <thead class={{this.headerClass}}>
      <tr>
        {{yield null "header" to="columns"}}
      </tr>
    </thead>
    <tbody>
      {{#each @data as |row|}}
        <tr>
          {{yield row "cell" to="columns"}}
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>