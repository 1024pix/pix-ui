<p class="pix-notification-alert {{concat 'pix-notification-alert--' this.type}}" ...attributes>
  {{#if @withIcon}}
    <PixIcon
      @name={{this.iconName}}
      @ariaHidden={{true}}
      @plainIcon={{true}}
      class="pix-notification-alert__icon"
    />
  {{/if}}
  <span class="pix-notification-alert__content">
    {{yield}}
  </span>
</p>